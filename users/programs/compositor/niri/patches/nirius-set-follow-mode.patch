+fn set_follow_mode(id: u64, policy: FollowPolicy) -> Result<String, String> {
+    let mut state = STATE.write().expect("Could not write() STATE.");
+    if !state.all_windows.iter().any(|window| window.id == id) {
+        return Err(format!("No window with id {id}"));
+    }
+
+    state.follow_mode_wins.insert(id, policy);
+    Ok(format!("Set follow mode policy of window {id} to {policy}"))
+}
